# ------------------------------------------------------------------
# French Tacos – variables d'environnement
# Copier en .env (serveur) ou .env.local (développement), puis compléter.
# Ne JAMAIS versionner le fichier rempli.
# ------------------------------------------------------------------

# --- Serveur (docker compose) ---
# Nom de domaine sans https:// (ex. frenchtacos-caen.fr)
DOMAINE=
# E-mail pour les certificats HTTPS Let's Encrypt
EMAIL_ACME=
# Mot de passe PostgreSQL (long et aléatoire : openssl rand -base64 32)
POSTGRES_PASSWORD=
# Jours de conservation des sauvegardes locales
RETENTION_JOURS=30

# --- Développement uniquement ---
# Adresse du site en local (en production, déduite de DOMAINE)
# SITE_URL=http://localhost:3000
# Sans DATABASE_URL, une base PostgreSQL embarquée (PGlite) est créée dans .donnees/
# DATABASE_URL=postgres://utilisateur:motdepasse@localhost:5432/frenchtacos

# --- Premier compte gérant (créé au premier démarrage si aucun compte n'existe) ---
ADMIN_EMAIL=
# 12 caractères minimum. Le retirer du fichier une fois le compte créé.
ADMIN_MOT_DE_PASSE=
ADMIN_NOM=Gérant

# --- Paiement Stripe (tableau de bord Stripe > Développeurs > Clés API) ---
# Clés de test (sk_test_ / pk_test_) pour la recette, clés live pour la production.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook : https://DOMAINE/api/stripe/webhook
# Événements : payment_intent.succeeded, payment_intent.canceled
STRIPE_WEBHOOK_SECRET=
# Serveur de démonstration : bandeau « commandes fictives », site non indexé,
# paiement simulé sans Stripe (voir docs/serveur-de-test.md). JAMAIS sur le site réel.
# SITE_TEST=1

# --- E-mails (confirmation client + alerte restaurant) ---
# smtp://utilisateur:motdepasse@smtp.fournisseur.fr:587
SMTP_URL=
EMAIL_EXPEDITEUR="French Tacos <commandes@exemple.fr>"
# Destinataire des alertes « nouvelle commande » (sinon l'e-mail des réglages)
EMAIL_RESTAURANT=

# --- Mentions légales ---
HEBERGEUR="Nom de l'hébergeur, adresse, téléphone"
REALISATION="Nom de l'agence"
